# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit secrets.

# Google Gemini API key for the LLM rent-extractor fallback.
# Get one at https://aistudio.google.com/apikey
# Leave empty to disable the LLM fallback (scraper will just skip price extraction
# when Kleinanzeigen's structured attributes have no rent info).
GEMINI_API_KEY=

# Discord webhook URL for new-listing notifications (backend-api).
# Create one via a Discord channel's Integrations > Webhooks settings.
# Leave empty to disable notifications - listings are still stored and queued
# in the outbox, so setting this later delivers the backlog on the next poll.
DISCORD_WEBHOOK_URL=