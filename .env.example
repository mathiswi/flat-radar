# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit secrets.

# Discord webhook URL for new-listing notifications (backend-api).
# Create one via a Discord channel's Integrations > Webhooks settings.
# Leave empty to disable notifications - listings are still stored and queued
# in the outbox, so setting this later delivers the backlog on the next poll.
DISCORD_WEBHOOK_URL=