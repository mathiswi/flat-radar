# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit secrets.

# Google Gemini API key for the LLM move-in-date ("Verfügbar ab") fallback (scraper).
# Get one at https://aistudio.google.com/apikey
# Used only as a last resort — when a Kleinanzeigen ad has no structured "Verfügbar ab"
# row and the cheap text scan can't find a date in the description. Leave empty to
# disable the LLM fallback (structured + text-scan dates still work).
GEMINI_API_KEY=

# Discord webhook URL for new-listing notifications (backend-api).
# Create one via a Discord channel's Integrations > Webhooks settings.
# Leave empty to disable notifications - listings are still stored and queued
# in the outbox, so setting this later delivers the backlog on the next poll.
DISCORD_WEBHOOK_URL=